# Run npm run setup:credentials locally to create a random keyring in .env.local.
# Production: supply a persistent secret from your hosting platform; all instances share it.
# Format: {"active":"v1","keys":{"v1":"<base64 of 32 random bytes>"}}
KAIPAI_CREDENTIAL_KEYS=

# Optional: browser-facing origin behind a reverse proxy, without trailing slash.
KAIPAI_PUBLIC_ORIGIN=

# Cloudflare Workers: use records; regular Node.js deployments leave this unset.
KAIPAI_DNS_RESOLVER=

# Optional: your actual public GitHub repository or profile URL, shown in the footer.
KAIPAI_GITHUB_URL=

# Never enable KAIPAI_ALLOW_LOOPBACK_API on a public deployment.
