{
  "name": "kaipai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node scripts/test-runner.cjs",
    "test:update": "UPDATE_WECHAT_BASELINES=1 node scripts/test-runner.cjs",
    "typecheck": "tsc --noEmit",
    "css:audit": "node scripts/css-audit.cjs",
    "start:local": "KAIPAI_ALLOW_LOOPBACK_API=1 next start --hostname 127.0.0.1 --port 3003",
    "setup:credentials": "node scripts/setup-credentials.cjs",
    "skills:sync": "node scripts/sync-skills.cjs",
    "cf:prepare": "node scripts/prepare-cloudflare.cjs",
    "cf:build": "npm run cf:sync-assets && node scripts/prepare-cloudflare.cjs && npm --prefix .cloudflare-deploy run build && node scripts/finalize-cloudflare.cjs && node scripts/verify-cloudflare-build.cjs --record",
    "cf:preview": "npm --prefix .cloudflare-deploy run preview",
    "cf:deploy": "node scripts/verify-github-release.cjs && node scripts/verify-cloudflare-build.cjs && npm --prefix .cloudflare-deploy run deploy",
    "cf:ci": "npm test && npm run typecheck && npm run cf:sync-assets && npm run cf:prepare && npm --prefix .cloudflare-deploy ci --legacy-peer-deps --no-audit --no-fund && npm --prefix .cloudflare-deploy run build && node scripts/finalize-cloudflare.cjs && node scripts/verify-cloudflare-build.cjs --record",
    "start:bridge": "KAIPAI_LOCAL_BRIDGE=1 KAIPAI_BRIDGE_ORIGIN=https://kaipai.kairostudio.workers.dev KAIPAI_ALLOW_LOOPBACK_API=1 next start --hostname 127.0.0.1 --port 3003",
    "cf:sync-assets": "node scripts/release-assets.cjs sync"
  },
  "dependencies": {
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "mammoth": "^1.12.3",
    "next": "15.5.28",
    "pdfjs-dist": "^6.3.289",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.7.2",
    "postcss": "8.5.31",
    "jszip": "3.10.2"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "overrides": {
    "postcss": "8.5.31",
    "source-map-js": "1.2.2"
  }
}
